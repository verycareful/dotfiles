/* GENERATED by `theme` from themes/templates — edit the template, not this file. Theme: {{name}} */
* {
    base:      #{{base}};
    mantle:    #{{mantle}};
    surface:   #{{surface}};
    overlay:   #{{overlay}};
    primary:   #{{primary}};
    primaryBr: #{{primary_bright}};
    accent:    #{{accent}};
    onAccent:  #{{on_accent}};
    text:      #{{text}};
    subtext:   #{{subtext}};
    muted:     #{{muted}};
    mantleGlass:  rgba({{mantle_rgb}}, {{glass|0.72}});
    fieldGlass:    rgba({{fill_field_rgb}}, {{field_alpha}});
    selectedGlass: rgba({{fill_selected_rgb}}, {{select_alpha}});
}
/* `highlight` only takes a literal colour, so it lives here */
element-text { highlight: bold #{{accent}}; }
