/* GENERATED by `theme` from themes/templates — edit the template, not this file. Theme: {{name}} */
* {
    base:      #{{base}};
    mantle:    #{{mantle}};
    surface:   #{{surface}};
    overlay:   #{{overlay}};
    primary:   #{{primary}};
    primaryBr: #{{primary_bright}};
    accent:    #{{accent}};
    text:      #{{text}};
    subtext:   #{{subtext}};
    muted:     #{{muted}};
    mantleGlass:  rgba({{mantle_rgb}}, 0.72);
    baseGlass:    rgba({{base_rgb}}, 0.6);
    primaryGlass: rgba({{primary_rgb}}, 0.45);
}
/* `highlight` only takes a literal colour, so it lives here */
element-text { highlight: bold #{{accent}}; }
