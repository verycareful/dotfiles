// GENERATED by `theme` from themes/templates/fastfetch/config.jsonc — theme {{name}}
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/anchor.txt",
        "type": "file",
        "color": { "1": "{{primary_bright_ansi}}", "2": "{{accent_ansi}}" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "{{accent_ansi}}", "title": "{{primary_bright_ansi}}", "separator": "{{muted_ansi}}" },
        "key": { "width": 10 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}{at-symbol-colored}{host-name}", "color": { "user": "{{accent_ansi}}", "at": "{{muted_ansi}}", "host": "{{primary_bright_ansi}}" } },
        { "type": "custom", "format": "──────────────────────────", "outputColor": "{{muted_ansi}}" },
        { "type": "os",       "key": "os",     "format": "{name} {version}" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "shell",    "key": "shell" },
        { "type": "terminal", "key": "term" },
        { "type": "packages", "key": "pkgs" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "custom", "format": "──────────────────────────", "outputColor": "{{muted_ansi}}" },
        { "type": "cpu",      "key": "cpu",    "format": "{name}" },
        { "type": "gpu",      "key": "gpu",    "format": "{name}", "hideType": "integrated" },
        { "type": "memory",   "key": "memory" },
        { "type": "disk",     "key": "disk",   "folders": "/" },
        { "type": "display",  "key": "display", "format": "{width}x{height} @ {refresh-rate}Hz" },
        { "type": "custom", "format": "──────────────────────────", "outputColor": "{{muted_ansi}}" },
        { "type": "colors",   "symbol": "circle", "paddingLeft": 0 }
    ]
}
