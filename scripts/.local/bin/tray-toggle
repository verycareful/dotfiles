#!/usr/bin/env bash
# tray-toggle — arrow for Waybar's tray drawer: 󰅀 (closed) / 󰅃 (open).
# State is tied to the running Waybar PID, so a restarted bar (drawer closed again) starts fresh.
#   tray-toggle status   print the icon as JSON
#   tray-toggle flip     toggle the state (the group's click-to-reveal opens the drawer itself)
set -uo pipefail
STATE="${XDG_RUNTIME_DIR:-/tmp}/waybar-tray"
pid=$(pgrep -o -x waybar || echo 0)
open=0; [[ -f "$STATE" && "$(cat "$STATE")" == "$pid open" ]] && open=1
case "${1:-status}" in
    flip)   if (( open )); then echo "$pid closed" > "$STATE"; else echo "$pid open" > "$STATE"; fi ;;
    status) if (( open )); then icon=$'\U000F0143'; cls=open; else icon=$'\U000F0140'; cls=closed; fi
            printf '{"text":"<span font_family=\\"JetBrainsMono Nerd Font\\">%s</span>","class":"%s","tooltip":"tray"}\n' "$icon" "$cls" ;;
esac
