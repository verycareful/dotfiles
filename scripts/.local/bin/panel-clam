#!/usr/bin/env bash
# panel-clam — ClamAV status as one JSON line for the Quickshell panel.
set -uo pipefail
block=$(systemctl is-active clamav-clamonacc@block 2>/dev/null); notify=$(systemctl is-active clamav-clamonacc@notify 2>/dev/null)
daemon=$(systemctl is-active clamav-daemon 2>/dev/null)
found=$(journalctl -u 'clamav-clamonacc@*' -b -o cat 2>/dev/null | grep -c 'moved to' || true)
log=$(ls -1t "$HOME/.local/state/clamav"/weekly-*.log 2>/dev/null | head -1)
last=""; infected=""; when=""
if [[ -n "$log" ]]; then when=$(basename "$log" .log | sed 's/weekly-//'); infected=$(grep -oE 'Infected files: [0-9]+' "$log" | grep -oE '[0-9]+$'); fi
sigs=$(sigtool --info /var/lib/clamav/daily.cld 2>/dev/null | grep -oE 'Build time: .*' | sed 's/Build time: //' | cut -d' ' -f1-3)
printf '{"block":"%s","notify":"%s","daemon":"%s","found":%s,"lastScan":"%s","lastInfected":"%s","log":"%s","sigs":"%s"}\n' \
    "$block" "$notify" "$daemon" "${found:-0}" "$when" "${infected:-}" "$log" "$sigs"
