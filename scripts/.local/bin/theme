#!/usr/bin/env bash
# theme — switch the colour theme across every app.
#   theme list            available themes (themes/*.theme in the dotfiles repo)
#   theme current         name of the active theme
#   theme set NAME        render colour files for NAME and reload running apps
#   theme toggle          cycle to the next theme
#   theme light | dark    switch to the light or dark half of the current pair (NAME / NAME-light)
#   theme pick            choose with rofi
#   theme window          choose in the Quickshell theme window (SUPER+Shift+T)
#   theme json            every theme's colours and wallpaper as JSON (what the window reads)
#   theme render TPL [N]  print template file TPL rendered with theme N (default: current)
#   theme check [N...]    validate themes (default: all) against every template
#   theme sddm [N] [DIR]  render the login screen (theme.conf + blurred bg.jpg) into DIR
#                         (default /var/lib/dotfiles-sddm, set up by sddm/install-sddm.sh)
# themes/render.py does the rendering and checks a theme before writing any of it.
# Rendering writes into $XDG_CONFIG_HOME (which is symlinked into the repo by
# stow, so the generated files stay tracked). --no-reload skips the live reload.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)"
TPL="$REPO/themes/templates"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"; mkdir -p "$STATE"

themes()  { local f; for f in "$REPO"/themes/*.theme; do f=${f##*/}; echo "${f%.theme}"; done; }
current() { cat "$STATE/current" 2>/dev/null || echo harbour; }
sibling() {  # $1 light|dark: the current theme's counterpart in that mode, if the repo has it
    local base; base=$(current); base=${base%-light}
    [[ $1 == light ]] && base="$base-light"
    [[ -f "$REPO/themes/$base.theme" ]] || { echo "no $1 theme for $(current)" >&2; exit 1; }
    echo "$base"
}

render() {  # $1 theme name
    local name="$1" file="$REPO/themes/$1.theme"
    python3 "$REPO/themes/render.py" all "$name" "$CFG"
    apps "$name"
    echo "$name" > "$STATE/current"
    # wallpaper for the theme
    local wp; wp=$(sed -n 's/^wallpaper=//p' "$file")
    [[ -n "$wp" ]] && echo "$wp" > "$STATE/wallpaper"
    # login screen follows, when install-sddm.sh has made its dir ours
    [[ -w "${SDDM_DIR:-/var/lib/dotfiles-sddm}" ]] && sddm_render "$name" "${SDDM_DIR:-/var/lib/dotfiles-sddm}" || true
}

# Apps whose colours live inside their own settings rather than a file we own: change only our part of them.
apps() {  # $1 theme name
    local name="$1"
    # btop: select the rendered theme (btop.conf is btop's own and holds every other setting)
    local btop="$CFG/btop/btop.conf"
    [[ -f $btop ]] && sed -i 's/^color_theme = .*/color_theme = "dotfiles"/' "$btop"
    # VS Code: workbench.colorTheme (light or dark base, for syntax colours) and workbench.colorCustomizations
    # are replaced, the rest of settings.json kept. It applies live.
    local code="$CFG/Code/User/settings.json"
    if [[ -f $code ]]; then
        "$0" render "$TPL/vscode/colors.json" "$name" | python3 -c '
import json, sys
path = sys.argv[1]
try:
    settings = json.load(open(path))
except ValueError:
    sys.exit("theme: VS Code settings.json has comments or trailing commas; colours not applied")
settings.update(json.load(sys.stdin))
json.dump(settings, open(path, "w"), indent=4)
' "$code" || true
    fi
    # Vesktop: the rendered theme sits in its themes folder; turn it on once in enabledThemes, the rest kept.
    # Vencord re-reads the themes folder while running, so a theme switch applies live.
    local vesk="$CFG/vesktop/settings/settings.json"
    if [[ -f $vesk ]]; then
        python3 -c '
import json, sys
path, css = sys.argv[1], "dotfiles.theme.css"
try:
    settings = json.load(open(path))
except ValueError:
    sys.exit("theme: Vesktop settings.json is not valid JSON; theme not enabled")
themes = settings.setdefault("enabledThemes", [])
if css not in themes:
    themes.append(css)
    json.dump(settings, open(path, "w"), indent=4)
' "$vesk" || true
    fi
    # Firefox: userChrome.css in every profile, unless one there is not ours; user.js turns stylesheets on
    local ff="$CFG/mozilla/firefox" prof css
    [[ -f $ff/profiles.ini ]] || ff="$HOME/.mozilla/firefox"
    if [[ -f $ff/profiles.ini ]]; then
        while read -r prof; do
            [[ -d $ff/$prof ]] || continue
            css="$ff/$prof/chrome/userChrome.css"
            if [[ -f $css ]] && ! grep -q 'GENERATED by `theme`' "$css"; then
                echo "theme: $css is not ours, Firefox left alone" >&2; continue
            fi
            mkdir -p "$ff/$prof/chrome"
            "$0" render "$TPL/firefox/userChrome.css" "$name" > "$css"
            grep -qs 'legacyUserProfileCustomizations.stylesheets' "$ff/$prof/user.js" \
                || echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >> "$ff/$prof/user.js"
        done < <(sed -n 's/^Path=//p' "$ff/profiles.ini")
    fi
}

sddm_render() {  # $1 theme name, $2 output dir — theme.conf + the wallpaper blurred and dimmed
    local name="$1" out="$2" file="$REPO/themes/$1.theme"
    { "$0" render "$TPL/sddm/theme.conf" "$name"; echo "User=\"$USER\""; } > "$out/theme.conf.tmp" && mv "$out/theme.conf.tmp" "$out/theme.conf"
    local wp; wp="${WALL_DIR:-$HOME/Pictures/Wallpapers}/$(sed -n 's/^wallpaper=//p' "$file")"
    [[ -f "$wp" ]] || wp="$REPO/wallpapers/$(sed -n 's/^wallpaper=//p' "$file")"
    if [[ -f "$wp" ]] && command -v magick >/dev/null; then
        magick "$wp" -resize 2560x1440^ -gravity center -extent 2560x1440 -blur 0x14 -fill black -colorize 42% -quality 88 "$out/bg.jpg.tmp" && mv "$out/bg.jpg.tmp" "$out/bg.jpg"
    fi
    chmod 644 "$out/theme.conf" "$out/bg.jpg" 2>/dev/null || true
}

reload() {
    local wp
    wp="${WALL_DIR:-$HOME/Pictures/Wallpapers}/$(cat "$STATE/wallpaper" 2>/dev/null)"
    [[ -f "$wp" ]] && command -v wall >/dev/null && wall set "$wp" >/dev/null 2>&1 || true
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1 || true   # also re-runs the cursor exec
    local cur; cur=$(sed -n 's/^cursor=//p' "$REPO/themes/$(current).theme")
    [[ -n "$cur" ]] && command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface cursor-theme "$cur" 2>/dev/null || true
    # libadwaita and GTK4 apps follow color-scheme while running; settings.ini only reaches them at launch
    local scheme; scheme=$(sed -n 's/^mode=//p' "$REPO/themes/$(current).theme")
    [[ -n "$scheme" ]] && command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface color-scheme "prefer-$scheme" 2>/dev/null || true
    # waybar 0.15 crashes on SIGUSR2/hyprctl reload, so restart it instead of signalling
    if systemctl --user is-active -q waybar; then systemctl --user restart waybar; else pkill -x waybar; (setsid waybar >/dev/null 2>&1 &); fi
    # hyprtoolkit reads its colours once at start: restart the polkit agent (the password prompt)
    systemctl --user try-restart hyprpolkitagent 2>/dev/null || true
    local kitty_opacity; kitty_opacity=$(sed -n 's/^glass=//p' "$REPO/themes/$(current).theme"); kitty_opacity=${kitty_opacity:-0.78}
    for s in /tmp/kitty-*; do                                   # recolour open terminals
        [[ -S "$s" ]] && kitty @ --to "unix:$s" set-colors --all --configured "$CFG/kitty/colors.conf" >/dev/null 2>&1 || true
        [[ -S "$s" ]] && kitty @ --to "unix:$s" set-background-opacity --all "$kitty_opacity" >/dev/null 2>&1 || true
        [[ -S "$s" ]] && kitty @ --to "unix:$s" load-config >/dev/null 2>&1 || true   # text_composition_strategy
    done
    command -v notify-send >/dev/null && notify-send -a theme "Theme: $(current)" "GTK/Qt apps, btop and Firefox pick it up on next launch; Vesktop now" || true
}

case "${1:-}" in
    list)    themes ;;
    current) current ;;
    set)     render "${2:?theme name}"; [[ "${3:-}" == "--no-reload" ]] || reload ;;
    toggle)  mapfile -t all < <(themes); cur=$(current); next="${all[0]}"
             for i in "${!all[@]}"; do [[ "${all[$i]}" == "$cur" ]] && next="${all[$(( (i+1) % ${#all[@]} ))]}"; done
             render "$next"; reload ;;
    light|dark) next=$(sibling "$1"); [[ $next == "$(current)" ]] || { render "$next"; [[ "${2:-}" == "--no-reload" ]] || reload; } ;;
    pick)    sel=$(themes | rofi -dmenu -p "theme") && [[ -n "$sel" ]] && { render "$sel"; reload; } ;;
    sddm)    sddm_render "${2:-$(current)}" "${3:-/var/lib/dotfiles-sddm}" ;;
    render)  python3 "$REPO/themes/render.py" one "${3:-$(current)}" "${2:?template path}" ;;
    window)  qs ipc call themes open ;;
    json)    python3 "$REPO/themes/render.py" json ;;
    check)   python3 "$REPO/themes/render.py" check "${@:2}" ;;
    *)       sed -n '2,13p' "$0"; exit 1 ;;
esac
