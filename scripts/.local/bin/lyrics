#!/usr/bin/env python3
"""lyrics: song lyrics from LRCLIB (lrclib.net) as one JSON line, for the dashboard's Now playing card.

    lyrics TITLE ARTIST [ALBUM] [LENGTH_SECONDS]

Prints {"synced": [[seconds, "line"], ...], "plain": ["line", ...], "instrumental": bool, "found": bool}.
`synced` is filled when LRCLIB has time-stamped lyrics, `plain` otherwise. An empty synced line is a gap in the
singing and stays in the list.

LRCLIB sees the title, artist, album and length of the song; nothing else is sent. Answers are cached under
$XDG_CACHE_HOME/lyrics: lyrics for good, a song LRCLIB does not have for MISS_DAYS, after which it is asked again.
A network failure is not cached, and prints found=false with "error" set."""
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = "https://lrclib.net/api"
USER_AGENT = "quickshell-dashboard-lyrics"
TIMEOUT_S = 8
MISS_DAYS = 7
LENGTH_SLACK_S = 3          # a search result within this many seconds of the song is the same recording
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "lyrics")

TAG = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


def parse_lrc(text):
    """[[seconds, line], ...] sorted by time from LRC text; metadata tags ([ar:...]) and untimed lines are dropped.
    A line with several time tags appears once per tag."""
    out = []
    for raw in (text or "").splitlines():
        stamps = []
        rest = raw.strip()
        while True:
            m = TAG.match(rest)
            if not m:
                break
            stamps.append(int(m.group(1)) * 60 + float(m.group(2)))
            rest = rest[m.end():]
        for t in stamps:
            out.append([round(t, 2), rest.strip()])
    out.sort(key=lambda x: x[0])
    return out


def result(record):
    """The printed answer for one LRCLIB record (None: not found)."""
    if not record:
        return {"synced": [], "plain": [], "instrumental": False, "found": False}
    synced = parse_lrc(record.get("syncedLyrics"))
    plain = [] if synced else (record.get("plainLyrics") or "").splitlines()
    return {"synced": synced, "plain": plain, "instrumental": bool(record.get("instrumental")), "found": True}


def cache_key(title, artist, album, length):
    raw = "\n".join([title.lower(), artist.lower(), album.lower(), str(round(length))])
    return hashlib.sha1(raw.encode()).hexdigest()


def pick(results, length):
    """The best search result: synced lyrics first, then the closest length; None if none is near enough."""
    near = [r for r in results if not length or abs((r.get("duration") or 0) - length) <= LENGTH_SLACK_S]
    if not near:
        return None
    near.sort(key=lambda r: (not r.get("syncedLyrics"), abs((r.get("duration") or 0) - length)))
    return near[0]


def fetch(path, params):
    url = f"{API}/{path}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise


def lookup(title, artist, album, length):
    params = {"track_name": title, "artist_name": artist}
    if album:
        params["album_name"] = album
    if length:
        params["duration"] = round(length)
    record = fetch("get", params)
    if record is None:
        record = pick(fetch("search", {"track_name": title, "artist_name": artist}) or [], length)
    return result(record)


def main(argv):
    if len(argv) < 3:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    title, artist = argv[1], argv[2]
    album = argv[3] if len(argv) > 3 else ""
    try:
        length = float(argv[4]) if len(argv) > 4 else 0.0
    except ValueError:
        length = 0.0

    path = os.path.join(CACHE, cache_key(title, artist, album, length) + ".json")
    try:
        with open(path) as f:
            cached = json.load(f)
        if cached.get("found") or time.time() - os.path.getmtime(path) < MISS_DAYS * 86400:
            print(json.dumps(cached))
            return 0
    except (OSError, ValueError):
        pass

    try:
        answer = lookup(title, artist, album, length)
    except (OSError, ValueError) as e:
        print(json.dumps({**result(None), "error": str(e)}))
        return 0
    os.makedirs(CACHE, exist_ok=True)
    with open(path, "w") as f:
        json.dump(answer, f)
    print(json.dumps(answer))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
