#!/usr/bin/env bash
# gpu-status — AMD dGPU usage/temp/VRAM as Waybar JSON (reads sysfs, no deps).
# Picks the amdgpu card with the most VRAM (the discrete one), so it survives
# card0/card1 renumbering across boots.
set -euo pipefail
best=""; bestvram=0
for c in /sys/class/drm/card?; do
    [[ -r "$c/device/mem_info_vram_total" ]] || continue
    v=$(<"$c/device/mem_info_vram_total")
    (( v > bestvram )) && { bestvram=$v; best=$c; }
done
[[ -n "$best" ]] || { echo '{"text":"󰢮 n/a","class":"disabled"}'; exit 0; }

busy=$(<"$best/device/gpu_busy_percent")
used=$(<"$best/device/mem_info_vram_used")
hw=$(ls -d "$best"/device/hwmon/hwmon* | head -1)
temp=$(( $(<"$hw/temp1_input") / 1000 ))
name=$(lspci -s "$(basename "$(readlink -f "$best/device")")" | sed 's/.*: //')
used_g=$(awk -v u="$used" 'BEGIN{printf "%.1f", u/1073741824}')
tot_g=$(awk -v t="$bestvram" 'BEGIN{printf "%.0f", t/1073741824}')

class="normal"; (( busy >= 90 )) && class="critical"; (( busy >= 60 && busy < 90 )) && class="warning"
printf '{"text":"󰢮 %d%%","tooltip":"%s\\nusage %d%%   temp %d°C\\nvram %s / %s GiB","class":"%s","percentage":%d}\n' \
    "$busy" "$name" "$busy" "$temp" "$used_g" "$tot_g" "$class" "$busy"
