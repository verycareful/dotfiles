// Waybar — layout. Styling lives in style.css.
// Docs: https://github.com/Alexays/Waybar/wiki
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 0,
    "reload_style_on_change": true,

    // ── layout ────────────────────────────────────────────────
    "modules-left":   ["clock#time", "clock#date", "idle_inhibitor", "custom/weather"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["mpris", "cpu", "memory", "custom/gpu", "network", "wireplumber",
                       "tray", "custom/notifications", "custom/keyhint", "custom/power"],

    // ── left ──────────────────────────────────────────────────
    "clock#time": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a %d %b}",
        "interval": 60,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<b>{}</b>",
                "weeks":    "<i>{:%V}</i>",
                "weekdays": "{}",
                "today":    "<b><u>{}</u></b>"
            }
        },
        "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
    },
    "idle_inhibitor": {
        // "caffeine": while active, hypridle won't lock/suspend the session
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated":   "caffeine ON — idle lock disabled",
        "tooltip-format-deactivated": "caffeine off"
    },
    "custom/weather": {
        "exec": "~/.local/bin/weather",
        "return-type": "json",
        "interval": 900,
        "on-click": "xdg-open https://wttr.in"
    },

    // ── centre ────────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "󰝥", "empty": "󰝦", "active": "󰝥", "urgent": "󰀨" },
        "persistent-workspaces": { "*": 5 },   // always show 1‑5 on every monitor
        "on-click": "activate",
        "on-scroll-up":   "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "sort-by-number": true
    },

    // ── right ─────────────────────────────────────────────────
    "mpris": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>{player_icon}</span>  {dynamic}",
        "format-paused": "<span font_family='JetBrainsMono Nerd Font'>{status_icon}</span>  <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 36,
        "player-icons": { "default": "󰝚", "spotify": "󰓇", "firefox": "󰈹" },
        "status-icons": { "paused": "󰏤" },
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },
    "cpu": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>󰻠</span> {usage}%",
        "interval": 2,
        "tooltip": true,
        "states": { "warning": 60, "critical": 90 }
    },
    "memory": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>󰍛</span> {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "states": { "warning": 70, "critical": 90 }
    },
    "custom/gpu": {
        "exec": "~/.local/bin/gpu-status",
        "return-type": "json",
        "interval": 2
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}   {bandwidthDownBytes} {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}   {bandwidthDownBytes} {bandwidthUpBytes}",
        "tooltip-format-disconnected": "disconnected",
        "interval": 5,
        "on-click": "nm-connection-editor"
    },
    "wireplumber": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>{icon}</span> {volume}%",
        "format-muted": "<span font_family='JetBrainsMono Nerd Font'>󰝟</span>",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "scroll-step": 5,
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "max-volume": 100
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification":          "󱅫",
            "none":                  "󰂚",
            "dnd-notification":      "󰂛",
            "dnd-none":              "󰂛",
            "inhibited-notification":"󱅫",
            "inhibited-none":        "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none":    "󰂛"
        },
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/keyhint": {
        "format": "󰌌",
        "tooltip-format": "keybinds",
        "on-click": "~/.local/bin/keyhint"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "power menu",
        "on-click": "wlogout -b 5 -T 320 -B 320 -L 420 -R 420"
    }
}
