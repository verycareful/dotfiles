# abbreviations: expand in place when you press space, so history stays readable
abbr -a g    git
abbr -a gs   git status -sb
abbr -a ga   git add
abbr -a gaa  git add -A
abbr -a gc   git commit -m
abbr -a gca  git commit --amend
abbr -a gp   git push
abbr -a gpl  git pull
abbr -a gl   git log --oneline --graph -20
abbr -a gd   git diff
abbr -a gco  git checkout
abbr -a gsw  git switch
abbr -a gb   git branch

abbr -a p    sudo pacman
abbr -a pi   sudo pacman -S --needed
abbr -a pr   sudo pacman -Rns
abbr -a pu   sudo pacman -Syu
abbr -a ps.  pacman -Ss
abbr -a y    yay
abbr -a yu   yay -Syu

abbr -a hc   hyprctl
abbr -a hr   hyprctl reload
abbr -a dot  cd ~/Sonnenplatz/Projects/Github/dotfiles
abbr -a ..   cd ..
abbr -a ...  cd ../..
