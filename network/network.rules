// The panel's Ethernet and Wi-Fi toggles run `networkctl up|down|reconfigure`: no password for wheel
// at the desk.
// Installed as /etc/polkit-1/rules.d/50-dotfiles-network.rules.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.network1.manage-links" ||
         action.id == "org.freedesktop.network1.reconfigure") &&
        subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
