{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-right": 0,
  "control-center-width": 400,
  "control-center-height": 720,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "inhibitors",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 0,
      "blur": false,
      "blacklist": [
        "playerctld"
      ]
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "clear"
    }
  },
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-margin-bottom": 0,
  "notification-visibility": {
    "spotify-by-name": {
      "app-name": "(?i)spotify",
      "state": "ignored"
    },
    "spotify-by-desktop": {
      "desktop-entry": "(?i)spotify",
      "state": "ignored"
    }
  }
}
