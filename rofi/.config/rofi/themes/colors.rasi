/* GENERATED by `theme` from themes/templates — edit the template, not this file. Theme: mono */
* {
    base:      #000000;
    mantle:    #060606;
    surface:   #101010;
    overlay:   #1c1c1c;
    primary:   #5c5c5c;
    primaryBr: #9c9c9c;
    accent:    #ffffff;
    text:      #f2f2f2;
    subtext:   #a6a6a6;
    muted:     #4e4e4e;
    mantleGlass:  rgba(6, 6, 6, 0.72);
    baseGlass:    rgba(0, 0, 0, 0.6);
    primaryGlass: rgba(92, 92, 92, 0.45);
}
/* `highlight` only takes a literal colour, so it lives here */
element-text { highlight: bold #ffffff; }
