/* rofi theme — sharp, glass. Colours come from colors.rasi (generated by `theme`). */
@import "colors"
* {
    background-color: transparent;
    text-color:       @text;
    font:             "Oxanium Medium 12";
}

window {
    location:         center;
    width:            640px;
    background-color: @mantleGlass;   /* blurred by Hyprland */
    border:           1px;
    border-color:     @overlay;
    border-radius:    0;
    padding:          0;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @baseGlass;
    border:           0 0 1px 0;
    border-color:     @overlay;
    padding:          14px 18px;
    spacing:          12px;
}
prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font 14";
}
entry {
    placeholder:       "search…";
    placeholder-color: @muted;
    cursor:            text;
}

message { padding: 8px 18px; }
textbox { text-color: @subtext; }

listview {
    lines:        8;
    columns:      1;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      0;
    padding:      6px 0;
}

element {
    padding: 8px 18px;
    spacing: 12px;
    cursor:  pointer;
}
element normal.normal  { text-color: @text; }
element normal.urgent  { text-color: @accent; }
element normal.active  { text-color: @primaryBr; }
element alternate.normal { text-color: @text; }
element selected.normal {
    background-color: @primaryGlass;
    text-color:       @text;
    border:           0 0 0 2px;
    border-color:     @accent;
}
element selected.urgent { background-color: @accent; text-color: @base; }
element selected.active { background-color: @primaryGlass; text-color: @primaryBr; }

element-icon {
    size:             1.4em;
    vertical-align:   0.5;
}
element-text {
    vertical-align:   0.5;
    highlight:        bold @accent;
}
