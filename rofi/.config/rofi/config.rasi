/* rofi — behaviour. Theme in themes/theme.rasi (colours generated into themes/colors.rasi) */
configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "󰀻";
    display-run:         "󰆍";
    display-window:      "󰖯";
    window-format:       "{w} · {c}   {t}";
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    terminal:            "kitty";
    /* every launch passes the permissions gate (clipboard blocking); ~/.local/bin is on PATH via uwsm.
       Without perms installed the command runs directly; with it, a refusal from the gate stands. */
    run-command:         "sh -c 'if command -v perms >/dev/null; then exec perms run \"$@\"; else exec \"$@\"; fi' sh {cmd}";
    kb-remove-to-eol:    "";
    kb-accept-entry:     "Return,KP_Enter";
    kb-row-up:           "Up,Control+k,Control+p";
    kb-row-down:         "Down,Control+j,Control+n";
}
@theme "theme"
