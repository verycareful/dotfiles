/* rofi theme — "Harbour": sharp, glass, orange caret. See palette.md */
* {
    base:     #06080e;
    mantle:   #0b0f1c;
    surface:  #111a30;
    overlay:  #1a2547;
    navy:     #1f3799;
    navyBr:   #3b5fe0;
    orange:   #ff8c32;
    text:     #e4e8f4;
    subtext:  #9aa3bd;
    muted:    #5d6784;

    background-color: transparent;
    text-color:       @text;
    font:             "Oxanium Medium 12";
}

window {
    location:         center;
    width:            640px;
    background-color: rgba(11, 15, 28, 0.72);   /* @mantle at 72% — blurred by Hyprland */
    border:           1px;
    border-color:     @overlay;
    border-radius:    0;
    padding:          0;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: rgba(6, 8, 14, 0.6);
    border:           0 0 1px 0;
    border-color:     @overlay;
    padding:          14px 18px;
    spacing:          12px;
}
prompt {
    text-color: @orange;
    font:       "JetBrainsMono Nerd Font 14";
}
entry {
    placeholder:       "search…";
    placeholder-color: @muted;
    cursor:            text;
}

message { padding: 8px 18px; }
textbox { text-color: @subtext; }

listview {
    lines:        8;
    columns:      1;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      0;
    padding:      6px 0;
}

element {
    padding: 8px 18px;
    spacing: 12px;
    cursor:  pointer;
}
element normal.normal  { text-color: @text; }
element normal.urgent  { text-color: @orange; }
element normal.active  { text-color: @navyBr; }
element alternate.normal { text-color: @text; }
element selected.normal {
    background-color: rgba(31, 55, 153, 0.45);   /* @navy glass */
    text-color:       @text;
    border:           0 0 0 2px;
    border-color:     @orange;
}
element selected.urgent { background-color: @orange; text-color: @base; }
element selected.active { background-color: rgba(31, 55, 153, 0.45); text-color: @navyBr; }

element-icon {
    size:             1.4em;
    vertical-align:   0.5;
}
element-text {
    vertical-align:   0.5;
    highlight:        bold #ff8c32;
}
