// clamav-weekly-scan.sh runs as the user and pauses the on-access notify tier for the length of the scan.
// No password for wheel at the desk to start or stop that one unit; every other ClamAV unit still asks.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "clamav-clamonacc@notify.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
